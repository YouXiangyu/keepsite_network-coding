{
  "name": "demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-web-runtime.mjs",
    "test:runtime": "npm run test:web",
    "test:web": "playwright test --config=playwright.web.config.ts",
    "test:reliability": "npm run build && playwright test --config=playwright.reliability.config.ts",
    "test:p2p": "playwright test --config=playwright.p2p.config.ts",
    "test:unit": "node --test tests/api.test.mjs tests/data.test.mjs tests/media-cache.test.mjs tests/account-sync.test.mjs tests/data-channel.test.mjs tests/peer-media.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:benchmark": "tsc --project benchmark/tsconfig.json && vite build --config vite.benchmark.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
