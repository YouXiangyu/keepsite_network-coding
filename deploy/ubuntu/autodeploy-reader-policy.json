{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::memoverse-media-125647512944-apne1/deploy/keepsite/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::memoverse-media-125647512944-apne1"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "deploy/keepsite/*"
          ]
        }
      }
    }
  ]
}
