[Unit]
Description=Publish this EC2 instance IPv4 and retain the Cloudflare A record on shutdown
Wants=network-online.target
After=network-online.target network.target
ConditionPathExists=/etc/keepsite/cloudflare.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/keepsite/admin/sync-cloudflare-dns.py publish --execute
TimeoutStartSec=90
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
StateDirectory=keepsite-ddns
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/keepsite-ddns
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
