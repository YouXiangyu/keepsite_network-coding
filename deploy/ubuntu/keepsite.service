[Unit]
Description=keepsite personal movie ticket API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=keepsite
Group=keepsite
WorkingDirectory=/opt/keepsite/current
EnvironmentFile=/etc/keepsite.env
Environment=TMPDIR=/opt/keepsite/shared/cache/tmp
ExecStart=/opt/keepsite/current/backend/.venv/bin/python -B -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --ws websockets-sansio --ws-max-size 65536 --ws-ping-interval 15 --ws-ping-timeout 15 --ws-per-message-deflate false
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/keepsite-v3
RestrictSUIDSGID=true
MemoryAccounting=true
MemoryHigh=1200M
MemoryMax=1500M
MemorySwapMax=2G
TasksMax=128
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
