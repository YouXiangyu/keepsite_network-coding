# Replace __DOMAIN__; validate separately before atomic activation.
# Access logs intentionally omit all query strings, including OAuth codes.
log_format memoverse_safe '$remote_addr - $request_method $uri $status $body_bytes_sent';
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    access_log /var/log/memoverse/nginx-access.log memoverse_safe;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /opt/memoverse/current/demo/dist/client;
    index index.html;
    client_max_body_size 13m;
    client_body_timeout 120s;
    access_log /var/log/memoverse/nginx-access.log memoverse_safe;
    error_log /var/log/memoverse/nginx-error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 180s;
    proxy_buffering off;
    proxy_request_buffering on;

    # This exact location suppresses both logs: Nginx error entries can include
    # the original request line even when the access format uses only $uri.
    location = /api/auth/callback {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8000;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    # Native browser launch also carries a short-lived, one-use flow handle.
    location = /api/auth/native/google/launch {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8000;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ^~ /api/auth/ {
        client_max_body_size 8k;
        proxy_pass http://127.0.0.1:8000;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /api/sync/events {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_pass http://127.0.0.1:8000;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /api { return 308 /api/; }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ /\. { deny all; }
    location = /index.html { add_header Cache-Control "no-cache" always; }
    location / { try_files $uri $uri/ /index.html; }
}
